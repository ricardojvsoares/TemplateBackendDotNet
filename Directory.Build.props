<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>All</AnalysisMode>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <Target
    Name="InstallGitPreCommitHook"
    BeforeTargets="Build"
    Condition="'$(DesignTimeBuild)' != 'true' AND Exists('$(MSBuildThisFileDirectory).git') AND Exists('$(MSBuildThisFileDirectory).githooks/pre-commit')">
    <Copy
      SourceFiles="$(MSBuildThisFileDirectory).githooks/pre-commit"
      DestinationFiles="$(MSBuildThisFileDirectory).git/hooks/pre-commit"
      SkipUnchangedFiles="true" />
    <Exec
      Command="chmod +x &quot;$(MSBuildThisFileDirectory).git/hooks/pre-commit&quot;"
      Condition="'$(OS)' != 'Windows_NT'" />
  </Target>
</Project>
